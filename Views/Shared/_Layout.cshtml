<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Café Aroma</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Estilos locales -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-warning" asp-controller="Ventas" asp-action="Index">
                    ☕ Café Aroma
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ventas" asp-action="Index"><i class="bi bi-cart-check"></i> POS Ventas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ventas" asp-action="Cocina"><i class="bi bi-egg-fried"></i> Cocina</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ventas" asp-action="Checklist"><i class="bi bi-clipboard-check"></i> Checklist</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ventas" asp-action="ReporteDiario"><i class="bi bi-file-earmark-bar-graph"></i> Rep. Diario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ventas" asp-action="MasVendidos"><i class="bi bi-graph-up-arrow"></i> Más Vendidos / Históricos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-white border-top py-3 mt-auto">
        <div class="container text-center text-muted">
            <small>&copy; @DateTime.Now.Year - Café Aroma | Sistema de Gestión</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>